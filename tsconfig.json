{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Examples import the package by name, as users do. Type-check them against the source;
    // at run time Node resolves the name to `dist` through the package's own `exports`.
    "paths": {
      "@moeru/cliff": ["./src/index.ts"],
      "@moeru/cliff/*": ["./src/*.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "examples", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
